      }
    },
    "/v1/sponsor": {
      "post": {
        "operationId": "sponsor42",
        "summary": "Unpaid request quotes 42 USDC on Base (x402) plus a card fallback",
        "responses": { "402": { "description": "Payment required" } }
      }
    }
  },
  "x-payment": {
    "scheme": "stripe",
    "amountUsd": 42,
